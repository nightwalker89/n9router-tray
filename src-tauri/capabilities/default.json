{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for n9 Control tray app",
  "windows": ["main", "terminal"],
  "permissions": [
    "core:default",
    "core:window:allow-create",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "positioner:default",
    "shell:allow-open",
    "store:allow-load",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:*" },
        { "url": "http://127.0.0.1:*" }
      ]
    }
  ]
}
